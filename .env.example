# =============================================================================
# HEAL ACTIVE – Beispiel-Umgebungsvariablen
# -----------------------------------------------------------------------------
# Diese Datei ist NUR eine Vorlage. Kopiere sie nach `.env.local` und trage dort
# deine echten Werte ein. `.env.local` ist per .gitignore ausgeschlossen.
# NIEMALS echte Keys, Passwoerter oder Zugangsdaten in das Repository committen.
# =============================================================================

# Oeffentliche Basis-URL (fuer Canonicals, Sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Admin-Bereich ------------------------------------------------------------
# PLATZHALTER: Die aktuelle Admin-Anmeldung ist bewusst eine einfache
# Demo-Implementierung (ein gemeinsames Passwort, Session-Cookie).
# Vor dem Livegang durch eine echte Auth-Loesung ersetzen
# (z. B. Auth.js / Clerk / SSO) – siehe README, Abschnitt "Offene Punkte".
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# --- Datenbank (noch nicht angebunden) ----------------------------------------
# DATABASE_URL="postgresql://user:password@localhost:5432/healactive"

# --- Headless Commerce / CMS (noch nicht angebunden) --------------------------
# COMMERCE_PROVIDER="mock"           # mock | shopify | commercetools | medusa
# COMMERCE_API_URL=""
# COMMERCE_API_TOKEN=""
# CMS_PROVIDER="mock"                # mock | sanity | storyblok | contentful
# CMS_API_URL=""
# CMS_API_TOKEN=""

# --- Payment (noch nicht angebunden) ------------------------------------------
# PAYMENT_PROVIDER="mock"            # mock | stripe | mollie | paypal
# PAYMENT_API_KEY=""
# PAYMENT_WEBHOOK_SECRET=""

# --- Versand / Fulfilment (noch nicht angebunden) -----------------------------
# SHIPPING_PROVIDER="mock"           # mock | dhl | dpd | sendcloud
# SHIPPING_API_KEY=""

# --- Transaktionale E-Mails (noch nicht angebunden) ---------------------------
# MAIL_PROVIDER="mock"               # mock | postmark | resend | sendgrid
# MAIL_API_KEY=""
# MAIL_FROM="noreply@example.com"
